# 실습 01: hindsight/.env로 복사해서 쓴다 (cp hindsight/.env.example hindsight/.env)
# .env는 .gitignore에 들어 있다. 키는 이 파일에만 두고 화면·로그·커밋에 남기지 않는다.

# --- 지우지 말 것 -------------------------------------------------------
# hindsight-api 1.0.0의 기본 호스트는 0.0.0.0이다. 내 컴퓨터에서만 열리게 한다.
HINDSIGHT_API_HOST=127.0.0.1
HINDSIGHT_API_PORT=8888
# 임베딩: onnx 공급자의 기본 모델이 intfloat/multilingual-e5-small(384차원, 다국어)이다.
# 이 줄을 지우면 기본값 local(영어 전용 BAAI/bge-small-en-v1.5)로 돌아간다.
HINDSIGHT_API_EMBEDDINGS_PROVIDER=onnx
HINDSIGHT_API_EMBEDDINGS_ONNX_MODEL_ID=intfloat/multilingual-e5-small
# 재순위: 기본값 local은 영어 전용 cross-encoder/ms-marco-MiniLM-L-6-v2라 한국어 질문의 순위를 흔든다.
# rrf는 모델 없이 검색 결과를 RRF로 합친다(리허설에서 한국어 질문 회상 4~5/7 → 7/7).
HINDSIGHT_API_RERANKER_PROVIDER=rrf

# --- LLM 공급자: 하나만 고른다 -------------------------------------------
# claude-code 공급자는 쓰지 않는다.

# (기본) Ollama — 내 컴퓨터에서 돈다. 키가 없다. 권장 모델 gemma3:12b(디스크 8.2GB, 실행 중 약 8GB)
HINDSIGHT_API_LLM_PROVIDER=ollama
HINDSIGHT_API_LLM_MODEL=gemma3:12b
HINDSIGHT_API_LLM_BASE_URL=http://127.0.0.1:11434/v1
HINDSIGHT_API_LLM_OLLAMA_NUM_CTX=16384

# (대안) API 키 공급자 — 위 네 줄을 주석 처리하고 아래 중 하나를 연다. 사용량만큼 과금된다.
# HINDSIGHT_API_LLM_PROVIDER=anthropic
# HINDSIGHT_API_LLM_MODEL=claude-haiku-4-5
# HINDSIGHT_API_LLM_API_KEY=
# HINDSIGHT_API_LLM_PROVIDER=openai
# HINDSIGHT_API_LLM_MODEL=gpt-4o-mini
# HINDSIGHT_API_LLM_API_KEY=

# --- LLM 요청 추적 ------------------------------------------------------
# 기본으로 켜져 있고(추출 요청 원문과 응답이 내장 DB에 남는다) 1일 보관된다.
HINDSIGHT_API_LLM_TRACE_RETENTION_DAYS=1
